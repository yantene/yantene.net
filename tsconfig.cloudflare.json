{
  "extends": "./tsconfig.json",
  "include": [
    // React Router が生成するルート型 (./+types/*)。typegen で更新される。
    ".react-router/types/**/*",
    "app/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    // strict / paths は親 tsconfig.json から継承する
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    // vite-plugin-svgr/client は `import X from "./x.svg?react"` の型を与える。
    "types": [
      "vite/client",
      "vite-plugin-svgr/client",
      "@testing-library/jest-dom"
    ],
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // 生成された型を実ファイルと同じ階層に解決させる (./+types/xxx の解決に必要)
    "rootDirs": [".", "./.react-router/types"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
