{
  "name": "yantene",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vp build",
    "preview": "pnpm run build && vp preview",
    "preview:staging": "CLOUDFLARE_ENV=staging pnpm run build && vp preview",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "typecheck": "pnpm run typegen && pnpm run rr-typegen && tsc -b",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "test": "vp test watch",
    "test:run": "vp test run",
    "smoke": "node scripts/smoke.mjs",
    "storybook:dev": "storybook dev -p 6006 --host 0.0.0.0",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:dev:migrate": "wrangler d1 migrations apply yantene-development --local",
    "db:dev:drop": "./scripts/d1/drop-all-tables.sh yantene-development",
    "db:dev:reset": "pnpm run db:dev:drop && pnpm run db:dev:migrate",
    "db:staging:migrate": "wrangler d1 migrations apply yantene-staging --env staging --remote",
    "db:staging:drop": "./scripts/d1/drop-all-tables.sh yantene-staging --remote --env staging",
    "db:staging:reset": "pnpm run db:staging:drop && pnpm run db:staging:migrate",
    "db:prod:migrate": "wrangler d1 migrations apply yantene-production --env production --remote",
    "db:prod:drop": "./scripts/d1/drop-all-tables.sh yantene-production --remote --env production",
    "db:prod:reset": "pnpm run db:prod:drop && pnpm run db:prod:migrate",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production",
    "release": "bash scripts/release.sh",
    "typegen": "wrangler types",
    "rr-typegen": "react-router typegen",
    "wrangler:check": "bash scripts/check-wrangler.sh",
    "postinstall": "pnpm run typegen && pnpm run rr-typegen && pnpm run emoji:svg",
    "emoji:svg": "node scripts/copy-emoji-svg.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sableclient/twemoji-font": "^1.0.4",
    "daisyui": "^5.7.27",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.13.5",
    "i18next": "^26.4.1",
    "isbot": "^5.2.2",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "microformats-parser": "^2.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "temml": "^0.13.5",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@react-router/dev": "^8.3.0",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@twemoji/svg": "^15.0.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "emojibase-data": "^17.0.0",
    "happy-dom": "^20.10.6",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@11.1.2"
}
