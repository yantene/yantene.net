{
  "name": "yantene",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build",
    "preview": "pnpm run build && vite preview",
    "preview:staging": "CLOUDFLARE_ENV=staging pnpm run build && vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix . --max-warnings 0",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check \"**/*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}\"",
    "format:fix": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write \"**/*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}\"",
    "typecheck": "pnpm run typegen && pnpm run rr-typegen && tsc -b",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "storybook:dev": "storybook dev -p 6006 --host 0.0.0.0",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:dev:migrate": "wrangler d1 migrations apply yantene-development --local",
    "db:dev:drop": "./scripts/d1/drop-all-tables.sh yantene-development",
    "db:dev:reset": "pnpm run db:dev:drop && pnpm run db:dev:migrate",
    "db:staging:migrate": "wrangler d1 migrations apply yantene-staging --env staging --remote",
    "db:staging:drop": "./scripts/d1/drop-all-tables.sh yantene-staging --remote --env staging",
    "db:staging:reset": "pnpm run db:staging:drop && pnpm run db:staging:migrate",
    "db:prod:migrate": "wrangler d1 migrations apply yantene-production --env production --remote",
    "db:prod:drop": "./scripts/d1/drop-all-tables.sh yantene-production --remote --env production",
    "db:prod:reset": "pnpm run db:prod:drop && pnpm run db:prod:migrate",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production",
    "release": "bash scripts/release.sh",
    "typegen": "wrangler types",
    "rr-typegen": "react-router typegen",
    "wrangler:check": "bash scripts/check-wrangler.sh",
    "postinstall": "pnpm run typegen && pnpm run rr-typegen"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sableclient/twemoji-font": "^1.0.4",
    "daisyui": "^5.7.16",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.13.1",
    "i18next": "^26.3.6",
    "isbot": "^5.2.1",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "microformats-parser": "^2.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "temml": "^0.13.4",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.3.0",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "^0.31.10",
    "emojibase-data": "^17.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
