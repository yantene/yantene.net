{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yantene",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    // どのコンテンツリポジトリを読むか (ADR 0034)。無い値・知らない値なら refresh が
    // throw する (fail-loud)。手元の作業ツリーを読む "local" を足すのは #461。
    "CONTENT_SOURCE": "artifacts",
    // Cloudflare Artifacts (コンテンツリポジトリ) の参照。アカウント ID と
    // API トークン (Artifacts > Read) は secret で与える:
    // ARTIFACTS_ACCOUNT_ID / ARTIFACTS_API_TOKEN。
    "ARTIFACTS_NAMESPACE": "yantene",
    // 手元から production のリポジトリを読まないよう staging 側を指す。
    "ARTIFACTS_REPO": "yantene-staging",
    "ARTIFACTS_BRANCH": "main",
    // ログイン (ADR 0039)。ここに書いたアドレスだけが入れて、管理者として扱われる。
    "ADMIN_EMAIL": "contact@yantene.net",
    // マジックリンクの差出人。送信専用のサブドメインで、返信は受け取らない。
    "MAIL_FROM": "no-reply@send.yantene.net",
  },
  // Email Sending: マジックリンクの配信 (ADR 0039)。送信元のドメインは
  // `wrangler email sending enable <domain>` で先に有効にしておくこと。
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  // Rate Limiting: ログインの依頼の連打を止める (ADR 0039)。**窓は 10 秒か 60 秒しか
  // 選べない**ので、担えるのは瞬間的な連打まで。受信箱を埋めさせない側の上限は
  // 生きているトークンの本数で別に持つ。namespace_id は環境ごとに分ける。
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  // Workers AI: 記事のベクトル (関連ノートの並び)。モデルは infra 側が持つ。
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "yantene-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  // R2: パース済み MDAST と画像アセットのキャッシュ (ADR 0005)。
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "yantene-development",
    },
  ],
  // KV: 読み手のセッション (ADR 0011)。development はローカルで模擬されるので id は使わない。
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "00000000000000000000000000000000",
    },
  ],
  "env": {
    "staging": {
      // workers.dev も残す。PR ごとの preview (versions upload --preview-alias) が
      // プレビュー URL を workers.dev 上に作るため。
      "workers_dev": true,
      // BASIC 認証があるので公開ドメインに出しても中身は見えない。
      "routes": [
        {
          "pattern": "staging.yantene.net",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "CONTENT_SOURCE": "artifacts",
        "ARTIFACTS_NAMESPACE": "yantene",
        // 環境ごとに別のリポジトリを読む。push の購読は 1 リポジトリに 1 つしか
        // 張れないので、同じリポジトリを両環境から自動同期できない。
        "ARTIFACTS_REPO": "yantene-staging",
        "ARTIFACTS_BRANCH": "main",
        "ADMIN_EMAIL": "contact@yantene.net",
        // production と差出人を分ける。受信箱でどちらから来たかが分かるように。
        "MAIL_FROM": "staging@send.yantene.net",
      },
      "send_email": [
        {
          "name": "EMAIL",
        },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "yantene-staging",
          "database_id": "a49de19e-eb9c-48f6-bbb4-67e7839e1b49",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "yantene-staging",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          "id": "2ef09db83bcb407198426e0c14f766b7",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "yantene-staging-content-events",
            // **同時に走らせない。** refresh は「コンテンツリポジトリのいまの姿」を
            // D1 / R2 に写す処理なので、並行させると先に読んだ側が後から書き、古い姿で
            // 固まる。直列なら 2 回目は 1 回目が書き終わってから最新を読み直すので、
            // 最後の push が必ず反映される。
            "max_concurrency": 1,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            // 3 回落ちたメッセージの行き先。ここが無いと黙って消え、push しても同期
            // されないことに誰も気づけない (ADR 0035)。
            "dead_letter_queue": "yantene-staging-content-events-dlq",
          },
          {
            // 落ちた push を記録に残すだけの consumer。同期はやり直さない。
            // 名前の末尾 "-dlq" で workers/app.ts が振り分ける。
            "queue": "yantene-staging-content-events-dlq",
            "max_concurrency": 1,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 0,
          },
        ],
      },
    },
    "production": {
      // workers.dev は開かない。同じ内容が 2 つの URL で引けると、検索エンジンから見て
      // 重複コンテンツになるため。
      "routes": [
        {
          "pattern": "yantene.net",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "CONTENT_SOURCE": "artifacts",
        "ARTIFACTS_NAMESPACE": "yantene",
        "ARTIFACTS_REPO": "yantene-production",
        "ARTIFACTS_BRANCH": "main",
        "ADMIN_EMAIL": "contact@yantene.net",
        "MAIL_FROM": "no-reply@send.yantene.net",
      },
      "send_email": [
        {
          "name": "EMAIL",
        },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "yantene-production",
          "database_id": "32bddf3b-622f-4fb7-ad09-bafdb8f2dda7",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "yantene-production",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          "id": "4710c1549b9c40ba97e0c05131caff53",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "yantene-production-content-events",
            // **同時に走らせない。** refresh は「コンテンツリポジトリのいまの姿」を
            // D1 / R2 に写す処理なので、並行させると先に読んだ側が後から書き、古い姿で
            // 固まる。直列なら 2 回目は 1 回目が書き終わってから最新を読み直すので、
            // 最後の push が必ず反映される。
            "max_concurrency": 1,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            // 3 回落ちたメッセージの行き先。ここが無いと黙って消え、push しても同期
            // されないことに誰も気づけない (ADR 0035)。
            "dead_letter_queue": "yantene-production-content-events-dlq",
          },
          {
            // 落ちた push を記録に残すだけの consumer。同期はやり直さない。
            // 名前の末尾 "-dlq" で workers/app.ts が振り分ける。
            "queue": "yantene-production-content-events-dlq",
            "max_concurrency": 1,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 0,
          },
        ],
      },
    },
  },
}
