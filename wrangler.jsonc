{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yantene",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    // コンテンツ正本をどちらから読むか (ADR 0034)。無い値・知らない値なら refresh が
    // throw する (fail-loud)。secret を置いたら "artifacts" に切り替える (#401)。
    "CONTENT_SOURCE": "github",
    // Cloudflare Artifacts (これからの正本) の参照。アカウント ID と API トークン
    // (Artifacts > Read) は secret で与える: ARTIFACTS_ACCOUNT_ID / ARTIFACTS_API_TOKEN。
    "ARTIFACTS_NAMESPACE": "yantene",
    // 手元から production のリポジトリを読まないよう staging 側を指す。
    "ARTIFACTS_REPO": "yantene-staging",
    "ARTIFACTS_BRANCH": "main",
    // GitHub リポジトリ (いまの正本) の参照。GITHUB_TOKEN は secret で与える。
    "GITHUB_OWNER": "yantene",
    "GITHUB_REPO": "notes",
    "GITHUB_BRANCH": "main",
  },
  // Workers AI: 記事のベクトル (関連ノートの並び)。モデルは infra 側が持つ。
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "yantene-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  // R2: パース済み MDAST と画像アセットのキャッシュ (ADR 0005)。
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "yantene-development",
    },
  ],
  // KV: 読み手のセッション (ADR 0011)。development はローカルで模擬されるので id は使わない。
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "00000000000000000000000000000000",
    },
  ],
  "env": {
    "staging": {
      // workers.dev も残す。PR ごとの preview (versions upload --preview-alias) が
      // プレビュー URL を workers.dev 上に作るため。
      "workers_dev": true,
      // BASIC 認証があるので公開ドメインに出しても中身は見えない。
      "routes": [
        {
          "pattern": "staging.yantene.net",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        // secret (ARTIFACTS_ACCOUNT_ID / ARTIFACTS_API_TOKEN) を置いたら
        // "artifacts" に切り替える (#401)。
        "CONTENT_SOURCE": "github",
        "ARTIFACTS_NAMESPACE": "yantene",
        // 環境ごとに別のリポジトリを読む。push の購読は 1 リポジトリに 1 つしか
        // 張れないので、同じリポジトリを両環境から自動同期できない。
        "ARTIFACTS_REPO": "yantene-staging",
        "ARTIFACTS_BRANCH": "main",
        "GITHUB_OWNER": "yantene",
        "GITHUB_REPO": "notes",
        "GITHUB_BRANCH": "staging",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "yantene-staging",
          "database_id": "a49de19e-eb9c-48f6-bbb4-67e7839e1b49",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "yantene-staging",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          "id": "2ef09db83bcb407198426e0c14f766b7",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "yantene-staging-content-events",
            // **同時に走らせない。** refresh は「正本のいまの姿」を D1 / R2 に写す処理なので、
            // 並行させると先に読んだ側が後から書き、古い姿で固まる。直列なら 2 回目は
            // 1 回目が書き終わってから最新を読み直すので、最後の push が必ず反映される。
            "max_concurrency": 1,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
    },
    "production": {
      // workers.dev は開かない。同じ内容が 2 つの URL で引けると、検索エンジンから見て
      // 重複コンテンツになるため。
      "routes": [
        {
          "pattern": "yantene.net",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "production",
        // staging で Artifacts の経路を確かめてから "artifacts" に切り替える (#401)。
        "CONTENT_SOURCE": "github",
        "ARTIFACTS_NAMESPACE": "yantene",
        "ARTIFACTS_REPO": "yantene-production",
        "ARTIFACTS_BRANCH": "main",
        "GITHUB_OWNER": "yantene",
        "GITHUB_REPO": "notes",
        "GITHUB_BRANCH": "main",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "yantene-production",
          "database_id": "32bddf3b-622f-4fb7-ad09-bafdb8f2dda7",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "yantene-production",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          "id": "4710c1549b9c40ba97e0c05131caff53",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "yantene-production-content-events",
            // **同時に走らせない。** refresh は「正本のいまの姿」を D1 / R2 に写す処理なので、
            // 並行させると先に読んだ側が後から書き、古い姿で固まる。直列なら 2 回目は
            // 1 回目が書き終わってから最新を読み直すので、最後の push が必ず反映される。
            "max_concurrency": 1,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
    },
  },
}
