{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yantene",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    // コンテンツ正本 (GitHub リポジトリ) の参照。GITHUB_TOKEN は secret で与える。
    "GITHUB_OWNER": "yantene",
    "GITHUB_REPO": "notes",
    "GITHUB_BRANCH": "main",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "yantene-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  // R2: パース済み MDAST と画像アセットのキャッシュ (ADR 0005)。
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "yantene-development",
    },
  ],
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "GITHUB_OWNER": "yantene",
        "GITHUB_REPO": "notes",
        "GITHUB_BRANCH": "staging",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "yantene-staging",
          "database_id": "a49de19e-eb9c-48f6-bbb4-67e7839e1b49",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "yantene-staging",
        },
      ],
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "GITHUB_OWNER": "yantene",
        "GITHUB_REPO": "notes",
        "GITHUB_BRANCH": "main",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "yantene-production",
          "database_id": "32bddf3b-622f-4fb7-ad09-bafdb8f2dda7",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "yantene-production",
        },
      ],
    },
  },
}
